# 复制为 .env 后填写；.env 已被 git 忽略，不要提交真实密钥。

# 数据库：专用库，初始化脚本只接受这个库名。密码认证可写成 postgresql://用户:密码@127.0.0.1:5432/lecture_demo_prototype
DATABASE_URL=postgresql:///lecture_demo_prototype

# 语言模型（讲义、出题、PPT、阅卷评分），任意 OpenAI 兼容接口。以下为阿里云百炼示例
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=600

# 视觉模型（图片识读、阅卷识读），原图只发给它，语言模型只接收解析文字
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-flash
VLM_API_KEY=

# 嵌入模型（向量检索，选填）。地址和密钥留空时沿用语言模型通道；模型名留空时使用 QWEN_MODEL
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_API_KEY=

# PPT 渲染页视觉审查（选填）：仅 Windows + PowerPoint + 本机 Ollama 视觉模型，其他环境自动跳过
PPT_AESTHETIC_BASE_URL=http://127.0.0.1:11434
PPT_AESTHETIC_MODEL=qwen3.5:9b

# 模型并发：同一时间最多几个语言模型调用（1—8，默认 3）。分章节写作与批量生成会用到；填 1 则严格逐个调用
MODEL_CONCURRENCY=3
# 嵌入接口单次请求的文本条数上限（百炼文档为 10；本机 Ollama 等可调大）
QWEN_EMBEDDING_BATCH_SIZE=10

PORT=5055
