DATABASE_URL=postgresql:///lecture_demo_prototype
QWEN_BASE_URL=http://172.18.36.44:8000/v1
QWEN_MODEL=qwen3.8-27b
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=600
# 嵌入模型留空则使用 QWEN_MODEL；检索需要该服务支持 OpenAI 兼容的 embeddings 接口
QWEN_EMBEDDING_MODEL=
# 留空则共用生成服务；也可独立设置本地 embedding，例如 http://127.0.0.1:11434/v1
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_API_KEY=
# 可选独立视觉模型：上传图片识读，解析文字可用于讲义生成，原图不发送到语言模型
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
PORT=5055
